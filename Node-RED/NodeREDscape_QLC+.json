        "name": "Process Serial Data",
        "func": "var parts = msg.payload.trim().split(':');\nmsg.output = parts;\n\nmsg.payload = parts[0];\n\n// Basic validation\nif(parts[0] == \"RFID\"){\n    node.status({ fill: \"green\", shape: \"ring\", text: parts[1] });\n    msg.payload = parts[1];\n    if (parts[1] == \"144B8E7B\"){\n        if(parts[2] == \"detected\")\n            msg.payload = \"QLC+API|setFunctionStatus|0|1\";\n        else if(parts[2] == \"removed\")\n            msg.payload = \"QLC+API|setFunctionStatus|0|0\";\n        node.status({ fill: \"red\", shape: \"ring\", text: parts[1] });\n        return msg;\n    }\n    else if (parts[1] == \"7461FA9E\"){\n        if(parts[2] == \"detected\")\n            msg.payload = \"QLC+API|setFunctionStatus|1|1\";\n        else if(parts[2] == \"removed\")\n            msg.payload = \"QLC+API|setFunctionStatus|1|0\";\n        node.status({ fill: \"red\", shape: \"ring\", text: parts[1] });\n        return msg;\n    }\n    else if (parts[1] == \"A4D0F09E\"){\n        if(parts[2] == \"detected\")\n            msg.payload = \"QLC+API|setFunctionStatus|2|1\";\n        else if(parts[2] == \"removed\")\n            msg.payload = \"QLC+API|setFunctionStatus|2|0\";\n        node.status({ fill: \"red\", shape: \"ring\", text: parts[1] });\n        return msg;\n    }\n}\nelse {\n        node.status({ fill: \"red\", shape: \"ring\" });\n}\nreturn msg;",
