    {
        "id": "54e5bf0ec14615f1",
        "type": "function",
        "z": "d19cdd983f224b46",
        "g": "668ac98aaecf641f",
        "name": "Process QLC+ Response",
        "func": "\nvar parts = msg.payload.split('|');\n\nmsg.output = parts;\n\n// Basic validation\nif(parts[0] == \"QLC+API\"){\n    if (parts[1] == \"getFunctionsList\"){\n        // Remove the first two fields: QLC+API and getFunctionsList\n        const data = parts.slice(2);\n        const rows = [];\n        for (let i = 0; i < data.length; i += 2) {\n            rows.push({\n                id: Number(data[i]),\n                name: data[i + 1]\n            });\n        }\n        msg.payload = rows;\n        return [msg, null];\n    }\n    else if (parts[1] == \"getWidgetsList\"){\n        // Remove the first two fields: QLC+API and getFunctionsList\n        const data = parts.slice(2);\n        const rows = [];\n        for (let i = 0; i < data.length; i += 2) {\n            rows.push({\n                id: Number(data[i]),\n                name: data[i + 1]\n            });\n        }\n        msg.payload = rows;\n        return [null, msg];\n    }\n\n\n}\nreturn [null, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 920,
