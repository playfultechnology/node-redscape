    {
        "id": "e4b8a6d1c2f3a301",
        "type": "function",
        "z": "9b1f4c32d872a001",
        "name": "Prepare Phiola play + pending PID map",
        "func": "/*\nExpected msg.payload:\n{\n    player: \"kitchen\",\n    source: \"radio\",\n    args: [\"--dev\", \"wasapi:Speakers\", \"C:\\\\Audio\\\\file.mp3\"]\n}\n\nThis stores a pending request before the Exec node starts.\nThe Status node later reports \"pid:1234\" and we match that PID\nback to this pending request in FIFO order.\n*/\n\nconst req = msg.payload || {};\nconst player = String(req.player || \"\").trim();\nconst source = String(req.source || \"\").trim();\nconst args = Array.isArray(req.args) ? req.args : [];\n\nif (!player || !source) {\n    node.error(\"Play request must include payload.player and payload.source\", msg);\n    return null;\n}\n\nif (!args.length) {\n    node.error(\"Play request must include payload.args array\", msg);\n    return null;\n}\n\nconst key = `${player}:${source}`;\n\nfunction quoteWinArg(value) {\n    const s = String(value).replace(/\"/g, '\\\\\"');\n    return `\"${s}\"`;\n}\n\n// Store pending launch so the next Exec status PID can be associated.\nconst pending = flow.get(\"phiolaPendingStarts\") || [];\npending.push({\n    key,\n    player,\n    source,\n    args,\n    requestedAt: Date.now()\n});\nflow.set(\"phiolaPendingStarts\", pending);\n\nmsg.player = player;\nmsg.source = source;\nmsg.phiolaKey = key;\n\n// This becomes the appended argument string for the Phiola Exec node.\nmsg.payload = args.map(quoteWinArg).join(\" \");\n\nnode.status({\n    fill: \"blue\",\n    shape: \"dot\",\n    text: `starting ${key}`\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 160,
        "wires": [
            [
                "f0c7e9a2d4b5c401"
            ]
        ]
    },
