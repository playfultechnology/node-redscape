    {
        "id": "b1b5edfb4ad57002",
        "type": "function",
        "z": "9b1f4c32d872a001",
        "name": "Parse status pid → store player:source PID",
        "func": "const text = String(msg.status?.text || \"\");\nconst match = text.match(/pid\\s*:\\s*(\\d+)/i);\n\nif (!match) {\n    return null;\n}\n\nconst pid = Number(match[1]);\n\nif (!Number.isInteger(pid) || pid <= 0) {\n    node.warn(`Invalid PID parsed from status: ${text}`);\n    return null;\n}\n\nconst pending = flow.get(\"phiolaPendingStarts\") || [];\n\nif (!pending.length) {\n    node.warn(`Got Phiola PID ${pid}, but there is no pending play request to associate it with`);\n    return null;\n}\n\n// Associate this PID with the oldest pending play request.\nconst req = pending.shift();\nflow.set(\"phiolaPendingStarts\", pending);\n\nconst players = flow.get(\"phiolaPlayers\") || {};\n\nplayers[req.key] = {\n    pid,\n    player: req.player,\n    source: req.source,\n    args: req.args,\n    startedAt: Date.now(),\n    statusText: text\n};\n\nflow.set(\"phiolaPlayers\", players);\n\nmsg.payload = {\n    event: \"started\",\n    key: req.key,\n    player: req.player,\n    source: req.source,\n    pid\n};\n\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: `${req.key} pid:${pid}`\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
