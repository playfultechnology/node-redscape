    {
        "id": "f6074c42e2998004",
        "type": "function",
        "z": "9b1f4c32d872a001",
        "name": "Build targeted taskkill command",
        "func": "/*\nExpected msg.payload:\n{\n    player: \"kitchen\",\n    source: \"radio\"\n}\n*/\n\nconst req = msg.payload || {};\nconst player = String(req.player || \"\").trim();\nconst source = String(req.source || \"\").trim();\n\nif (!player || !source) {\n    node.error(\"Stop request must include payload.player and payload.source\", msg);\n    return null;\n}\n\nconst key = `${player}:${source}`;\nconst players = flow.get(\"phiolaPlayers\") || {};\nconst entry = players[key];\n\nif (!entry || !entry.pid) {\n    node.warn(`No running Phiola PID found for ${key}`);\n    return null;\n}\n\nconst pid = Number(entry.pid);\n\nif (!Number.isInteger(pid) || pid <= 0) {\n    node.error(`Invalid PID stored for ${key}: ${entry.pid}`, msg);\n    return null;\n}\n\n// /T = also terminate child processes\n// /F = force termination\nmsg.payload = `/PID ${pid} /T /F`;\nmsg.phiolaKey = key;\nmsg.player = player;\nmsg.source = source;\nmsg.pid = pid;\n\n// Remove immediately so repeated stop clicks do not keep re-killing same PID.\ndelete players[key];\nflow.set(\"phiolaPlayers\", players);\n\nnode.status({\n    fill: \"yellow\",\n    shape: \"dot\",\n    text: `stopping ${key} pid:${pid}`\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
